diff --git a/python/sglang/kernels/ops/moe/muse_spark_nvfp4_experts_sm90.py b/python/sglang/kernels/ops/moe/muse_spark_nvfp4_experts_sm90.py
new file mode 100644
index 0000000..f77a222
--- /dev/null
+++ b/python/sglang/kernels/ops/moe/muse_spark_nvfp4_experts_sm90.py
@@ -0,0 +1,247 @@
+"""Routed NVFP4 experts for Muse Spark on Hopper (CUDA JIT).
+
+Replaces the two Marlin GEMMs and the activation between them for one rank's
+experts: pre-expert RMSNorm, gate/up GEMM, SwiGLU and down GEMM run in two
+kernel launches, with the NVFP4 weights dequantized in registers and fed to
+``wgmma`` as BF16. Above 256 tokens two launches come first, four in all: a fill
+that zeroes the route counts and a kernel that counts the routes. Products are
+exact and accumulate in fp32, as on the Marlin path; see
+``muse_spark/nvfp4_experts_sm90.cuh``.
+
+The kernel is specialized to the released checkpoint's expert shape (32 local
+experts of 4096 x 4096, top-8); other shapes and devices keep Marlin.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional, Tuple
+
+import torch
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    is_arch_support_pdl,
+    load_jit,
+    make_cpp_args,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+# The expert shape the kernel is compiled for: kNumLocalExperts, kExpertDim and
+# kTopK in nvfp4_experts_sm90.cuh.
+_NUM_LOCAL_EXPERTS = 32
+_EXPERT_DIM = 4096
+_TOPK = 8
+
+# Weight layout shared with nvfp4_experts_sm90.cuh: per (128 output rows, 64 input
+# columns) one block of 4096 code bytes followed by 512 block-scale bytes
+# (kWeightBlockBytes).
+_ROWS_PER_BLOCK = 128
+_COLS_PER_BLOCK = 64
+_BLOCK_BYTES = 4608
+# E4M3 byte of 1.0, the scale given to a block whose own scale is zero.
+_UNIT_SCALE_BYTE = 0x38
+
+# An expert's routes fill row tiles, which hold under 64 rows beyond the routes. The
+# plan has room for a tile per 32 routes plus two per expert, more than any plan
+# lists. These bound the buffers below and must match kMaxPadRows, kPlanTileRoutes
+# and kPlanTileDone (the plan header) in the .cuh.
+_MAX_PAD_ROWS = 64
+_PLAN_TILE_ROUTES = 32
+_PLAN_HEADER_INTS = 128
+# kBlockRoutesMaxTokens in the .cuh: up to here the gather kernel works out the
+# routes itself; above, a route-position kernel counts them with atomics into
+# plan[:32], which must then start at zero.
+_BLOCK_ROUTES_MAX_TOKENS = 256
+
+# Bit positions of (m0, m1, m2, sign) of the E2M1 code in nibble slot i of a 32-bit
+# weight word; convert8() in the .cuh extracts each slot with one mask after a rotate.
+_CODE_BIT_POS = (
+    (0, 1, 26, 9),
+    (28, 29, 30, 5),
+    (2, 3, 4, 11),
+    (6, 7, 8, 15),
+    (16, 17, 10, 25),
+    (12, 13, 14, 21),
+    (18, 19, 20, 27),
+    (22, 23, 24, 31),
+)
+# Nibble slot of the code at (row half, column pair, column parity) within a word.
+_SLOT_ORDER = (3, 7, 1, 5, 2, 6, 0, 4)
+
+
+def nvfp4_experts_sm90_supported(
+    *,
+    num_local_experts: int,
+    hidden_size: int,
+    intermediate_size: int,
+    top_k: int,
+    device_capability: Optional[Tuple[int, int]],
+) -> bool:
+    return (
+        device_capability == (9, 0)
+        and num_local_experts == _NUM_LOCAL_EXPERTS
+        and hidden_size == _EXPERT_DIM
+        and intermediate_size == _EXPERT_DIM
+        and top_k == _TOPK
+    )
+
+
+def block_scales_supported(*block_scales: torch.Tensor) -> bool:
+    """Whether the kernel decodes every block scale exactly.
+
+    It does for positive normal E4M3 bytes (0x08..0x7E), and for zero, which the
+    repack turns into zero codes. Subnormal, negative and NaN encodings are not.
+    """
+    for scale in block_scales:
+        raw = scale.view(torch.uint8)
+        if bool((((raw < 0x08) & (raw != 0)) | (raw > 0x7E)).any()):
+            return False
+    return True
+
+
+def pack_nvfp4_expert_weights(
+    weight: torch.Tensor,  # [E, N, K / 2] uint8, E2M1 code pairs, low nibble first
+    block_scale: torch.Tensor,  # [E, N, K / 16] fp8 e4m3
+    *,
+    gated: bool,
+) -> torch.Tensor:
+    """Lossless repack to [E, N / 128, K / 64, 4608] uint8 for the sm_90 kernel.
+
+    ``gated`` interleaves the gate and up halves of ``N`` so that one 128-row block
+    holds 64 gate rows and their 64 up rows. A block with a zero scale is stored as
+    zero codes with scale 1.0: the same weights, and no zero for the kernel to decode.
+    """
+    num_experts, n, half_k = weight.shape
+    k = 2 * half_k
+    row_blocks, col_blocks = n // _ROWS_PER_BLOCK, k // _COLS_PER_BLOCK
+    device = weight.device
+    if gated:
+        block = torch.arange(row_blocks, device=device).view(row_blocks, 1, 1)
+        group = torch.arange(8, device=device).view(1, 8, 1)
+        lane = torch.arange(16, device=device).view(1, 1, 16)
+        base = 64 * block + 8 * group + lane
+        row_perm = torch.where(lane < 8, base, n // 2 + base - 8).reshape(-1)
+    else:
+        row_perm = torch.arange(n, device=device)
+
+    packed = torch.empty(
+        (num_experts, row_blocks, col_blocks, _BLOCK_BYTES),
+        dtype=torch.uint8,
+        device=device,
+    )
+    scale_bytes = block_scale.view(torch.uint8)
+    for expert in range(num_experts):
+        rows, scales = weight[expert], scale_bytes[expert]
+        zero_scale = scales == 0
+        if bool(zero_scale.any()):
+            # One scale covers 16 codes, i.e. 8 weight bytes.
+            rows = rows.masked_fill(zero_scale.repeat_interleave(8, dim=-1), 0)
+            scales = scales.masked_fill(zero_scale, _UNIT_SCALE_BYTE)
+        rows = rows[row_perm]
+        codes = torch.stack((rows & 15, rows >> 4), dim=-1).flatten(-2)  # [N, K]
+        # Rows split as [block, warpgroup, warp, half, lane group]; columns as
