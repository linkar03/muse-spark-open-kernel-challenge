+// clang-format on
+
+SGL_DEVICE uint32_t bf162_u32(__nv_bfloat162 v) {
+  return *reinterpret_cast<uint32_t*>(&v);
+}
+
+SGL_DEVICE __nv_bfloat162 u32_bf162(uint32_t v) {
+  return *reinterpret_cast<__nv_bfloat162*>(&v);
+}
+
+// Two E4M3 block scales of a 32-bit word (bytes 0, 1 for hi = 0; bytes 2, 3 for hi = 1; low byte: row g, high byte:
+// row g + 8) -> bf16x2 of scale * 2^119. For a positive normal E4M3 byte b those bf16 bits are exactly
+// (b << 4) + 0x7780 (exponent rebias 120 + 119, mantissa bits moved up 4); the weight loader admits no other scale.
+// The byte permute selects the pair itself, so no shift or mask (hi is a compile-time constant in the unrolled loops).
+SGL_DEVICE uint32_t scale_pair_sel(uint32_t w, int hi, uint32_t m16) {
+  return __byte_perm(w, 0u, hi ? 0x4342 : 0x4140) * m16 + 0x77807780u;  // m16 = Args::mul16: IMAD on the FMA pipe
+}
+
+// 8 E2M1 codes -> 4 bf16x2 A-fragment registers, scaled. The weight repack places each code's bits so that one mask
+// (after a shift or rotate) leaves a register half holding sign << 15 | magnitude << 6: as bf16 bits that is exactly
+// e2m1 * 2^-126 (subnormal for magnitude 1), and times scale * 2^119 it is e2m1 * scale * 2^-7 (the epilogue's * 128
+// undoes the 2^-7). Bit positions in q (m0, m1, m2, sign); codes A, B are k = 2 * (lane & 3) and k + 1 (+ 8 in a2, a3):
+//   a0 (row g):   code A (6, 7, 8, 15),   code B (22, 23, 24, 31)   q & M
+//   a1 (row g+8): code A (2, 3, 4, 11),   code B (18, 19, 20, 27)   (q * 16) & M
+//   a2 (row g):   code A (28, 29, 30, 5), code B (12, 13, 14, 21)   rotl(q, 10) & M
+//   a3 (row g+8): code A (0, 1, 26, 9),   code B (16, 17, 10, 25)   (q * 64) & 0x80C080C0 | rotl(q, 14) & 0x01000100
+// The two shifts are multiplies by m16 / m64, so that for small tiles they run as IMAD on the FMA pipe instead of on
+// the half-rate integer pipe (see Args::mul16).
+SGL_DEVICE void convert8(uint32_t q, uint32_t sb, uint32_t (&a)[4], uint32_t m16, uint32_t m64) {
+  const __nv_bfloat162 s = u32_bf162(sb);
+  const __nv_bfloat162 slo = __low2bfloat162(s), shi = __high2bfloat162(s);
+  constexpr uint32_t M = 0x81C081C0u;
+  const uint32_t r0 = q & M;
+  const uint32_t r1 = (q * m16) & M;
+  const uint32_t r2 = __funnelshift_l(q, q, 10) & M;
+  const uint32_t r3 = ((q * m64) & 0x80C080C0u) | (__funnelshift_l(q, q, 14) & 0x01000100u);
+  a[0] = bf162_u32(__hmul2(u32_bf162(r0), slo));
+  a[1] = bf162_u32(__hmul2(u32_bf162(r1), shi));
+  a[2] = bf162_u32(__hmul2(u32_bf162(r2), slo));
+  a[3] = bf162_u32(__hmul2(u32_bf162(r3), shi));
+}
+
+// One GEMM of the fused kernel; a weight n-tile is 128 output rows. Tile layout (X and the GEMM1 output): a tile of
+// n rows is 64 k-blocks of n rows x 128 bytes, the 16-byte chunk c of row r stored at chunk c ^ (r & 7). A tile's
+// rows may be fewer than its width (see tile_rows): the ring then carries only the rows.
+struct Args {
+  const uint8_t* wrep;    // [E][ntiles_per_expert][kNumKBlocks][kWeightBlockBytes]
+  const uint8_t* xt;      // activations in tile layout (byte base; a tile starting at row r0 is at r0 * 8192)
+  const int4* tiles;      // (expert, row0, width, rows): the wgmma's token columns and the rows the tile holds
+  const int* num_tiles;   // device scalar
+  const float* gscale;    // [E]
+  uint8_t* out;           // GEMM1: tile layout (bytes); GEMM2: row-major bf16 [rows, 4096]
+  int ntiles_per_expert;  // weight n-tiles per expert
+  int* counter;           // persistent kernel work queue (zeroed before launch)
+  // Must be 16 and 64, from the host: multiplies by them stay IMAD (FMA-heavy pipe); ptxas sees through an
+  // inline-asm zero and turns `x * (16 + 0)` back into an integer-pipe shift.
+  uint32_t mul16, mul64;
+};
+
+// Persistent kernel: each block takes items (tile, n-tile) from a global counter, every GEMM1 item before any GEMM2
+// item; X and W stream through a ring of kNumSlots slots, epilogues go through a separate staging buffer.
+constexpr int kSlotBytes = 43008;  // bytes per ring slot (1024-aligned): fits one stage of any tile width
+constexpr int kNumSlots = 4;
+
+// k-blocks per ring stage by token-tile width (a stage must fit a slot: widths up to 32 allow 1, 2 or 4, widths 64
+// and 128 1 or 2, width 256 1). Widths up to 64 are weight-conversion-bound; 160, 192 (fine plan only) and 256 take
+// one.
+constexpr int kKBlocksPerStage32 = 4;
+constexpr int kKBlocksPerStage64 = 2;
+constexpr int kKBlocksPerStage128 = 2;
+SGL_DEVICE constexpr int k_blocks_per_stage(int width) {
+  return width >= 160 ? 1
+                      : (width <= 32 ? kKBlocksPerStage32 : (width <= 64 ? kKBlocksPerStage64 : kKBlocksPerStage128));
+}
+// A stage (its k-blocks of X and W) must fit a ring slot, and its k-blocks must divide the kNumKBlocks.
+static_assert(
+    kKBlocksPerStage32 * (32 * 128 + kWeightBlockBytes) <= kSlotBytes && kNumKBlocks % kKBlocksPerStage32 == 0,
+    "a stage of a 32-wide tile does not fit a ring slot");
+static_assert(
+    kKBlocksPerStage64 * (64 * 128 + kWeightBlockBytes) <= kSlotBytes && kNumKBlocks % kKBlocksPerStage64 == 0,
+    "a stage of a 64-wide tile does not fit a ring slot");
+static_assert(
+    kKBlocksPerStage128 * (128 * 128 + kWeightBlockBytes) <= kSlotBytes && kNumKBlocks % kKBlocksPerStage128 == 0,
+    "a stage of a 128-wide tile does not fit a ring slot");
+static_assert(256 * 128 + kWeightBlockBytes <= kSlotBytes, "a stage of a 256-wide tile does not fit a ring slot");
+
+// IMAD shifts only for token tiles up to this width (measured on H200: width 128 is 2-3% slower with them).
+constexpr int kImadShiftMaxWidth = 64;
+// Token tiles up to this width alternate the k16 steps of a commit group between two more accumulator sets.
+constexpr int kFourAccumulatorsMaxWidth = 32;
+// The producer prefetches the weights into L2 this many ring stages (>= 1) ahead of their bulk load (no smem, no
+// barrier), so the weight stream keeps more bytes in flight than the ring holds. Measured on H200: 1 stage, on every
+// item, +0.29%.
+constexpr int kL2PrefetchStages = 1;
+
+// Copy-out queue in the expert kernel's shared memory (offsets from its 1024-aligned base): kSmemPublished = jobs
+// published (release store by consumer thread 0; -(count + 1) at exit), kSmemQueued = consumer thread 0's own count,
+// kSmemFreed = jobs whose staging reads the publisher has finished, then from kSmemJobs = pubq 8 entries of 32 bytes
+// {dst, done, kind, amount, 8 unused}. kind 0: `amount` bytes of tile layout (one bulk copy); kind 1: `amount` token
+// rows of 256 bytes (272-byte staging pitch).
+constexpr int kSmemPublished = 240;
+constexpr int kSmemQueued = 244;
+constexpr int kSmemFreed = 248;
+constexpr int kSmemJobs = 256;
+
+// The queue counter at shared-memory offset `offset`, from the queue entries at pubq.
+SGL_DEVICE volatile int* queue_counter(volatile long long* pubq, int offset) {
+  return reinterpret_cast<volatile int*>(pubq) - (kSmemJobs - offset) / 4;
+}
+
+SGL_DEVICE void enqueue_out(volatile long long* pubq, void* dst, int* done, int kind, int amount) {
+  volatile int* cnt = queue_counter(pubq, kSmemQueued);
+  const int n = *cnt;
+  volatile long long* e = pubq + 4 * (n & 7);
+  e[0] = (long long)dst;
+  e[1] = (long long)done;
+  reinterpret_cast<volatile int*>(e)[4] = kind;
+  reinterpret_cast<volatile int*>(e)[5] = amount;
+  *cnt = n + 1;
+  st_release_cta(to_shared((const void*)queue_counter(pubq, kSmemPublished)), n + 1);
+}
+
+// consumer thread 0: wait until the publisher has read every queued staging buffer
+SGL_DEVICE void wait_staging_free(volatile long long* pubq) {
+  const int n = *queue_counter(pubq, kSmemQueued);
+  const uint32_t a = to_shared((const void*)queue_counter(pubq, kSmemFreed));
+  while (true) {
+    const int freed = ld_acquire_cta(a);
+    if (freed >= n) break;
+  }
+}
+
+// Threads 0..127: producer warpgroup (thread 0 issues the loads, warp 1 publishes epilogues); 128..383: consumers.
+constexpr int kProducerThreads = 128;  // also the first consumer thread
+constexpr int kFusedThreads = 384;
+constexpr int kConsumerThreads = kFusedThreads - kProducerThreads;
+
+// Named barrier 1: the consumer threads only.
+SGL_DEVICE void consumer_sync() {
+  named_bar_sync(1, kConsumerThreads);
+}
+
+// One item on the 256 consumer threads: N token rows times one weight n-tile, GEMM1 (gated: SwiGLU, tile layout out)
+// or GEMM2 (bf16 rows out). The epilogue is handed to the publisher warp through pubq, so the next item's main loop
+// does not wait for the copy-out or for the fence before `done`. The tile holds tile_rows <= N rows: the wgmma's
+// other columns read past them in the ring slot, and their sums are never stored.
+template <int N, bool kGroupedKBlock>
+SGL_DEVICE void consumer_item(
+    const Args& p,
+    uint8_t* ring,
+    uint8_t* stg,
+    uint32_t bars,
+    int& slot,
+    uint32_t& ph,
+    int e,
+    int row0,
+    int ntile,
+    bool gated,
+    int* done,
+    volatile long long* pubq,
+    int tile_rows) {
+  // small tiles: multipliers ptxas cannot see (host values), so the shifts run as IMAD on the FMA-heavy pipe
+  const uint32_t m16 = N <= kImadShiftMaxWidth ? p.mul16 : 16u;
+  const uint32_t m64 = N <= kImadShiftMaxWidth ? p.mul64 : 64u;
+  constexpr int kStageKBlocks = k_blocks_per_stage(N);
+  const int rows = N > 128 ? N : tile_rows;  // (wide tiles always hold N rows)
+  const int xb = rows * 128;                 // X bytes per k-block in the ring slot
+  const int ctid = threadIdx.x - kProducerThreads;
+  const int wg = ctid >> 7;
+  const int w = (ctid >> 5) & 3;
+  const int lane = ctid & 31;
+  const int g = lane >> 2;
+  // kGroupedKBlock (small token tiles): the wgmma is short, so one commit group carries a whole k-block (4 x k16)
+  // and the next k-block's conversions overlap it (one group in flight, double-buffered A fragments). The kernel
+  // instantiation picks the widths that get it: ptxas serializes the wgmma of one with more than three (C7512).
+  // small token tiles: a commit group's MMAs are shorter than the wgmma latency, so consecutive groups accumulate into
+  // two register sets, and up to kFourAccumulatorsMaxWidth tokens the k16 steps of a group alternate between two more
+  // (all summed before the epilogue). The summation order thus depends on the tile width; above kBlockRoutesMaxTokens
+  // tokens rows are placed with atomics, so a route's tile, and its output bits, can change from run to run.
+  constexpr int kNumAcc = kGroupedKBlock ? (N <= kFourAccumulatorsMaxWidth ? 4 : 2) : 1;
+  float acc[128];
+  float acc2[128];             // only the first N/2 are live (and only when kNumAcc > 1)
+  float acc3[128], acc4[128];  // kNumAcc == 4 only
+#pragma unroll
+  for (int i = 0; i < N / 2; ++i)
+    acc[i] = 0.f;
+#pragma unroll
+  for (int i = 0; i < (kNumAcc > 1 ? N / 2 : 0); ++i)
+    acc2[i] = 0.f;
+#pragma unroll
+  for (int i = 0; i < (kNumAcc > 2 ? N / 2 : 0); ++i)
+    acc3[i] = 0.f;
+#pragma unroll
+  for (int i = 0; i < (kNumAcc > 3 ? N / 2 : 0); ++i)
+    acc4[i] = 0.f;
+  uint32_t afrag[kGroupedKBlock ? 8 : 2][4];
+  int prev = -1;
+  const int woff = ((wg * 4 + w) * 32 + lane) * 16, soff = 4096 + ((wg * 4 + w) * 8 + g) * 8;
+  // packed weights/scales are loaded one k-block ahead, across stage boundaries too
+  mbar_wait(bars + 8 * slot, ph);
+  uint4 nwq = *reinterpret_cast<const uint4*>(ring + slot * kSlotBytes + kStageKBlocks * xb + woff);
+  uint2 nsc = *reinterpret_cast<const uint2*>(ring + slot * kSlotBytes + kStageKBlocks * xb + soff);
+  for (int it = 0; it < kNumKBlocks / kStageKBlocks; ++it) {
+    uint8_t* st = ring + slot * kSlotBytes;
+    const uint8_t* wbase = st + kStageKBlocks * xb + woff;
+    const uint8_t* sbase = st + kStageKBlocks * xb + soff;
+    const uint64_t dbase = desc_sw128(to_shared(st));
+    if (it > 0) {
+      mbar_wait(bars + 8 * slot, ph);
+      nwq = *reinterpret_cast<const uint4*>(wbase);
+      nsc = *reinterpret_cast<const uint2*>(sbase);
+    }
+#pragma unroll
+    for (int kk = 0; kk < kStageKBlocks; ++kk) {
+      const uint4 wq = nwq;
+      const uint2 sc = nsc;
+      if (kk + 1 < kStageKBlocks) {
+        nwq = *reinterpret_cast<const uint4*>(wbase + (kk + 1) * kWeightBlockBytes);
+        nsc = *reinterpret_cast<const uint2*>(sbase + (kk + 1) * kWeightBlockBytes);
+      }
+
+      // the k-block's X tile sits kk * xb bytes into the slot: its descriptor is the slot's plus kk * xb / 16
+      const uint64_t desc = dbase + (uint64_t)((kk * xb) >> 4);
+      if constexpr (kGroupedKBlock) {
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          const uint32_t q = j == 0 ? wq.x : j == 1 ? wq.y : j == 2 ? wq.z : wq.w;
+          const uint32_t sw = j < 2 ? sc.x : sc.y;  // scales of k16 steps (j & ~1, j | 1): bytes 0,1 and 2,3
+          convert8(q, scale_pair_sel(sw, j & 1, m16), afrag[(kk & 1) * 4 + j], m16, m64);
+        }
+        wg_fence();
+#pragma unroll
+        for (int j = 0; j < 4; ++j)
+          wgmma_rs<N>(
+              kNumAcc > 2 ? ((kk & 1) ? ((j & 1) ? acc4 : acc2) : ((j & 1) ? acc3 : acc))
+                          : ((kNumAcc > 1 && (kk & 1)) ? acc2 : acc),
+              afrag[(kk & 1) * 4 + j],
+              desc + 2 * j,
+              1);
+        wg_commit();
+        wg_wait<1>();
+        // the previous stage's MMAs are complete after the first wait of this stage: hand its slot back early
+        if (kk == 0 && prev >= 0) mbar_arrive(bars + 8 * kNumSlots + 8 * prev);
+      } else {
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          const uint32_t q = j == 0 ? wq.x : j == 1 ? wq.y : j == 2 ? wq.z : wq.w;
+          const uint32_t sw = j < 2 ? sc.x : sc.y;  // scales of k16 steps (j & ~1, j | 1): bytes 0,1 and 2,3
+          convert8(q, scale_pair_sel(sw, j & 1, m16), afrag[j & 1], m16, m64);
+          wg_fence();
+          wgmma_rs<N>(acc, afrag[j & 1], desc + 2 * j, 1);
+          wg_commit();
+          wg_wait<1>();
+          if (kk == 0 && j == 0 && prev >= 0) mbar_arrive(bars + 8 * kNumSlots + 8 * prev);
+        }
+      }
+    }
+    prev = slot;
+    if (++slot == kNumSlots) {
+      slot = 0;
+      ph ^= 1;
+    }
+  }
+  wg_wait<0>();
+  mbar_arrive(bars + 8 * kNumSlots + 8 * prev);
+  if constexpr (kNumAcc > 3) {
+#pragma unroll
+    for (int i = 0; i < N / 2; ++i)
+      acc[i] = (acc[i] + acc3[i]) + (acc2[i] + acc4[i]);
+  } else if constexpr (kNumAcc > 1) {
+#pragma unroll
+    for (int i = 0; i < N / 2; ++i)
+      acc[i] += acc2[i];
+  }
+  // epilogue through the staging buffer; * 128 undoes the dequant's 2^-7. As on the Marlin path, the sums round to
+  // bf16 and are then scaled in bf16 by the global scale (a bf16 value).
+  const __nv_bfloat162 gs = __float2bfloat162_rn(p.gscale[e]);
+  if (ctid == 0) wait_staging_free(pubq);
+  consumer_sync();  // previous item's copy-out is done with the staging buffer
+  if (gated) {
+    // the repack makes weight rows g and g+8 of warp q's 16 the gate and up rows of intermediate column
+    // 64 * ntile + 8 * q + g
+    const int q = wg * 4 + w;
+    // stmatrix.trans: the accumulator fragment of an 8-token group is an 8x8 matrix [row g][token]; stored transposed,
+    // each token's 8 rows (16 bytes) land in its tile-layout chunk in one instruction per 4 groups
+#pragma unroll
+    for (int j4 = 0; j4 < (N + 31) / 32; ++j4) {
+      if (32 * j4 >= rows) continue;  // token groups past the tile's rows
+      uint32_t r[4];
+#pragma unroll
+      for (int u = 0; u < 4; ++u) {
+        const int jj = 4 * j4 + u;
+        r[u] = 0;  // (a group past the tile's rows or width is staged as zeros and never copied out)
+        if (jj < N / 8 && 8 * jj < rows) {
+          const __nv_bfloat162 gate = __hmul2(__floats2bfloat162_rn(acc[4 * jj] * 128.f, acc[4 * jj + 1] * 128.f), gs);
+          const __nv_bfloat162 up =
+              __hmul2(__floats2bfloat162_rn(acc[4 * jj + 2] * 128.f, acc[4 * jj + 3] * 128.f), gs);
+          const float2 g = __bfloat1622float2(gate), v = __bfloat1622float2(up);
+          r[u] = bf162_u32(__floats2bfloat162_rn(silu(g.x) * v.x, silu(g.y) * v.y));
+        }
+      }
+      const int rr = lane & 7, tokr = 8 * (4 * j4 + (lane >> 3)) + rr;
+      stmatrix_x4_trans(to_shared(stg + tokr * 128 + ((q ^ rr) << 4)), r);
+    }
+    // the publisher warp copies the staged tile out (bulk copy) and then publishes `done`
+    asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+    consumer_sync();
+    if (ctid == 0) enqueue_out(pubq, p.out + (size_t)row0 * 8192 + (size_t)ntile * xb, done, 0, xb);
+  } else {
+    // halves of up to 128 tokens through the 128-row staging buffer: half 1 (tiles over 128 rows) holds N - 128 rows
+    auto gemm2_half = [&]<int kHalf, int kNumGroups>() {
+      if (kHalf) consumer_sync();                                // (half 0 was copied out by the consumers themselves)
+      const int ntok = min(rows - kHalf * 128, 8 * kNumGroups);  // this half's rows
+      // stmatrix.trans: per 8-token group, two 8x8 matrices (this warp's columns 16w..16w+7 and 16w+8..16w+15)
+#pragma unroll
+      for (int j2 = 0; j2 < (kNumGroups + 1) / 2; ++j2) {
+        if (16 * j2 >= ntok) continue;  // token groups past the tile's rows
+        uint32_t r[4];
+#pragma unroll
+        for (int u = 0; u < 2; ++u) {
+          const int ai = 4 * (2 * j2 + u + kHalf * 16);
+          r[2 * u] = r[2 * u + 1] = 0;
+          if (2 * j2 + u < kNumGroups && 8 * (2 * j2 + u) < ntok) {
+            r[2 * u] = bf162_u32(__hmul2(__floats2bfloat162_rn(acc[ai] * 128.f, acc[ai + 1] * 128.f), gs));
+            r[2 * u + 1] = bf162_u32(__hmul2(__floats2bfloat162_rn(acc[ai + 2] * 128.f, acc[ai + 3] * 128.f), gs));
+          }
+        }
+        const int m = lane >> 3, rr = lane & 7;
+        const int tl = 8 * (2 * j2 + (m >> 1)) + rr;
+        stmatrix_x4_trans(to_shared(stg + tl * 272 + ((wg * 4 + w) * 16 + 8 * (m & 1)) * 2), r);
+      }
+      // the last half goes to the publisher warp (its copy loop overlaps the next item); a first half is copied by the
+      // consumers, since the second half needs the staging buffer right away
+      if (kHalf == (N > 128 ? 1 : 0)) {
+        consumer_sync();
+        if (ctid == 0)
+          enqueue_out(pubq, p.out + ((size_t)(row0 + kHalf * 128) * 4096 + ntile * 128) * 2, done, 1, ntok);
+      } else {
+        consumer_sync();
+        for (int i = ctid; i < ntok * 16; i += kConsumerThreads) {
+          const int tl = i >> 4, c = i & 15;
+          *reinterpret_cast<uint4*>(p.out + ((size_t)(row0 + kHalf * 128 + tl) * 4096 + ntile * 128) * 2 + c * 16) =
+              *reinterpret_cast<const uint4*>(stg + tl * 272 + c * 16);
+        }
+      }
+    };
+    gemm2_half.template operator()<0, (N > 128 ? 16 : N / 8)>();
+    if constexpr (N > 128) gemm2_half.template operator()<1, (N - 128) / 8>();
+  }
+}
+
+// g2.xt must be g1.out and both must use the same tile list; the tile count and the work counter are g1's.
+struct FusedArgs {
+  Args g1, g2;  // GEMM1 (gated, writes inter in tile layout) and GEMM2 (reads inter, writes y)
+  int* done;    // [max tiles] GEMM1 n-tiles finished per token tile (zeroed before launch)
+};
+
+// Shared memory of the expert kernel from its 1024-aligned base: [0, 64) full and empty ring barriers, [64, 96)
+// item-ring barriers (2 full, 2 empty), [240, 512) copy-out queue, [512, 520) item ring, then kNumSlots ring slots
+// and up to kStagingBytes (128 rows x 272). Dynamic shared memory must cover that plus 1023 alignment bytes.
+constexpr int kSmemItemBarriers = 16 * kNumSlots;
+constexpr int kSmemItemRing = 512;
+constexpr int kSmemRing = 1024;
+constexpr int kStagingBytes = 128 * 272;
+static_assert(kSmemItemBarriers + 32 <= kSmemPublished && kSmemJobs + 8 * 32 <= kSmemItemRing);
+static_assert(kSmemItemRing + 8 <= kSmemRing && kSmemRing % 1024 == 0 && kSlotBytes % 1024 == 0);
+
+// Polls of a tile's GEMM1 progress (at least 64 ns apart) before the producer gives up: seconds, where a real wait
+// is far under a millisecond. A broken plan then fails the launch instead of hanging the device.
+constexpr int kMaxDoneSpins = 1 << 24;
+
+// GEMM1 -> SwiGLU -> GEMM2 for every tile of the plan in one launch. The instantiation must match the plan's `fine`:
+// the producer traps on a tile of a width the instantiation lacks.
+//   kFine = 0 (few tokens): widths 8, 16 and 32 with a grouped k-block, then 64, 128 and 256. Most experts get a
+//     handful of routes, and a wgmma as wide as the routes keeps the tensor core off empty columns.
+//   kFine = 1 (many tokens): widths 32, 64 and 128 with a grouped k-block, then 160, 192 and 256.
+template <int kFine, bool kUsePDL>
+__global__ void __launch_bounds__(kFusedThreads, 1) moe_fused_persistent(FusedArgs fa) {
+  device::PDLTriggerSecondary<kUsePDL>();
+  device::PDLWaitPrimary<kUsePDL>();
+  extern __shared__ __align__(1024) uint8_t smem_raw[];
+  const uint32_t raw = to_shared(smem_raw);
+  const uint32_t pad = ((raw + 1023) & ~1023u) - raw;
+  uint8_t* base = smem_raw + pad;
+  const uint32_t bars = to_shared(base);
+  const uint32_t ibar = bars + kSmemItemBarriers;
+  volatile int* iring = reinterpret_cast<volatile int*>(base + kSmemItemRing);
+  uint8_t* ring = base + kSmemRing;
+  uint8_t* stg = ring + kNumSlots * kSlotBytes;
+  volatile long long* pubq = reinterpret_cast<volatile long long*>(base + kSmemJobs);
+  if (threadIdx.x == 0) {
+    *reinterpret_cast<volatile int*>(base + kSmemPublished) = 0;
+    *reinterpret_cast<volatile int*>(base + kSmemQueued) = 0;
+    *reinterpret_cast<volatile int*>(base + kSmemFreed) = 0;
+    for (int s = 0; s < kNumSlots; ++s) {
+      mbar_init(bars + 8 * s, 1);
+      // every consumer thread arrives, so each lane's generic reads of the slot are ordered before its own arrive;
+      // a lane-0-only arrive would need a warp barrier first
+      mbar_init(bars + 8 * kNumSlots + 8 * s, kConsumerThreads);
+    }
+    for (int k = 0; k < 2; ++k) {
+      mbar_init(ibar + 8 * k, 1);
+      mbar_init(ibar + 16 + 8 * k, kConsumerThreads);  // every consumer thread, after its own read of iring
+    }
+    asm volatile("fence.mbarrier_init.release.cluster;" ::: "memory");
+  }
+  __syncthreads();
+  const int nt = *fa.g1.num_tiles;
+  const int n1 = nt * fa.g1.ntiles_per_expert, nitems = n1 + nt * fa.g2.ntiles_per_expert;
+  int slot = 0;
+  uint32_t ph = 0;
+  if (threadIdx.x < kProducerThreads) {
+    asm volatile("setmaxnreg.dec.sync.aligned.u32 40;\n");
+    if (threadIdx.x == 0) {
+      int k = 0;
+      uint32_t iph = 0;
+      while (true) {
+        mbar_wait(ibar + 16 + 8 * k, iph ^ 1);
+        const int item = atomicAdd(fa.g1.counter, 1);
+        iring[k] = item;
+        mbar_arrive(ibar + 8 * k);
+        if (item >= nitems) break;
+        const bool second = item >= n1;
+        const Args& p = second ? fa.g2 : fa.g1;
+        const int it2 = second ? item - n1 : item;
+        const int tile = it2 / p.ntiles_per_expert, ntile = it2 - tile * p.ntiles_per_expert;
+        const int4 ti = p.tiles[tile];
+        const int e = ti.x, row0 = ti.y, n = ti.z;
+        // A width this instance lacks (plan and instance out of step, or a corrupted plan) would leave the consumers
+        // without a case and the device hanging: fail the launch. The check sits here and not in the consumers'
+        // switch, where a trap makes ptxas serialize their wgmma (C7512).
+        const bool own_width = kFine != 0 ? n == 160 || n == 192 : n == 8 || n == 16;  // this instantiation's only
+        if (!(n == 32 || n == 64 || n == 128 || n == 256 || own_width)) __trap();
+        if (second) {  // the tile's GEMM1 rows must be complete, then visible to the async proxy
+          const int need = fa.g1.ntiles_per_expert;
+          uint32_t* tile_done = reinterpret_cast<uint32_t*>(fa.done + tile);
+          for (int spins = 0;; ++spins) {
+            const int v = static_cast<int>(device::atomic::ptx::load_acquire_u32(tile_done));
+            if (v >= need) break;
+            if (spins == kMaxDoneSpins) __trap();  // GEMM1 never completed the tile: fail the launch
+            __nanosleep(64);
+          }
+          asm volatile("fence.proxy.async.global;" ::: "memory");
+        }
+        const int kps = k_blocks_per_stage(n);
+        const uint32_t xb = ti.w * 128;
+        const uint8_t* wsrc = p.wrep + ((size_t)(e * p.ntiles_per_expert + ntile) * kNumKBlocks) * kWeightBlockBytes;
+        const uint8_t* xsrc = p.xt + (size_t)row0 * 8192;
+        // the item's first stages: a head start while the previous item's last stages are consumed
+        for (int j = 0; j < kL2PrefetchStages && j < kNumKBlocks / kps; ++j)
+          prefetch_l2(wsrc + (size_t)j * kps * kWeightBlockBytes, kps * kWeightBlockBytes);
+        for (int it = 0; it < kNumKBlocks / kps; ++it) {
+          if (it + kL2PrefetchStages < kNumKBlocks / kps)
+            prefetch_l2(wsrc + (size_t)(it + kL2PrefetchStages) * kps * kWeightBlockBytes, kps * kWeightBlockBytes);
+          // the consumers read the slot's codes and scales with generic loads; only this empty-barrier wait orders
+          // them before the async-proxy overwrite (no fence.proxy.async; compute-sanitizer racecheck flags the reuse)
+          mbar_wait(bars + 8 * kNumSlots + 8 * slot, ph ^ 1);
+          const uint32_t full = bars + 8 * slot;
+          mbar_expect_tx(full, kps * xb + kps * kWeightBlockBytes);
+          const uint32_t dst = to_shared(ring + slot * kSlotBytes);
+          bulk_g2s(dst, xsrc + (size_t)it * kps * xb, kps * xb, full);
+          bulk_g2s(dst + kps * xb, wsrc + (size_t)it * kps * kWeightBlockBytes, kps * kWeightBlockBytes, full);
+          if (++slot == kNumSlots) {
+            slot = 0;
+            ph ^= 1;
+          }
+        }
+        k ^= 1;
+        if (k == 0) iph ^= 1;
+      }
+    } else if (threadIdx.x >= 32 && threadIdx.x < 64) {
+      // publisher warp: copies each staged epilogue out while the consumers go on with their next item, frees the
+      // staging buffer once read, and for GEMM1 waits for the writes, then a GPU-scope release and the tile's done
+      // counter (read with acquire by other CTAs' producers)
+      const int lane = threadIdx.x - 32;
+      const uint32_t stg_s = to_shared(stg);
+      int seen = 0;
+      while (true) {
+        int r = ld_acquire_cta(to_shared(base + kSmemPublished));
+        r = __shfl_sync(0xffffffffu, r, 0);  // one value for the warp (a later lane may see a newer count)
+        const int avail = r < 0 ? -r - 1 : r;
+        while (seen < avail) {
+          volatile long long* e = pubq + 4 * (seen & 7);
+          uint8_t* dst = reinterpret_cast<uint8_t*>(e[0]);
+          int* d = reinterpret_cast<int*>(e[1]);
+          const int kind = reinterpret_cast<volatile int*>(e)[4], amount = reinterpret_cast<volatile int*>(e)[5];
+          if (kind == 0) {  // one contiguous tile-layout block: a single bulk copy
+            if (lane == 0) {
+              bulk_s2g(dst, stg_s, amount);
+              asm volatile("cp.async.bulk.commit_group;" ::: "memory");
+              asm volatile("cp.async.bulk.wait_group.read 0;" ::: "memory");
+            }
+          } else {  // token rows of 256 bytes (272-byte staging pitch): the warp copies them, 16 bytes per lane
+            for (int i = lane; i < amount * 16; i += 32) {
+              const int tl = i >> 4, c = i & 15;
+              *reinterpret_cast<uint4*>(dst + (size_t)tl * 8192 + c * 16) =
+                  *reinterpret_cast<const uint4*>(stg + tl * 272 + c * 16);
+            }
+          }
+          __syncwarp();  // after lane 0's bulk-copy read of the staging buffer has completed
+          st_release_cta(to_shared(base + kSmemFreed), seen + 1);
+          if (lane == 0) {
+            if (d) {
+              if (kind == 0) {  // a bulk (async-proxy) copy: wait for its writes first
+                asm volatile("cp.async.bulk.wait_group 0;" ::: "memory");
+                asm volatile("fence.proxy.async.global;" ::: "memory");
+              }
+              asm volatile("fence.acq_rel.gpu;" ::: "memory");
+              atomicAdd(d, 1);
+            }
+          }
+          ++seen;
+        }
+        if (r < 0) break;
+        __nanosleep(64);
+      }
+      asm volatile("cp.async.bulk.wait_group 0;" ::: "memory");
+    }
+  } else {
+    asm volatile("setmaxnreg.inc.sync.aligned.u32 232;\n");
+    int k = 0;
+    uint32_t iph = 0;
+    while (true) {
+      mbar_wait(ibar + 8 * k, iph);
+      const int item = iring[k];
+      consumer_sync();
+      mbar_arrive(ibar + 16 + 8 * k);  // all: each reader orders its own read
+      if (item >= nitems) {
+        if (threadIdx.x == kProducerThreads) {  // the publisher drains the queue and exits
+          const int pubn = *reinterpret_cast<volatile int*>(base + kSmemQueued);
+          st_release_cta(to_shared(base + kSmemPublished), -(pubn + 1));
+        }
+        break;
+      }
+      k ^= 1;
+      if (k == 0) iph ^= 1;
+      const bool first = item < n1;
+      const Args& p = first ? fa.g1 : fa.g2;
+      const int it2 = first ? item : item - n1;
+      const int tile = it2 / p.ntiles_per_expert, ntile = it2 - tile * p.ntiles_per_expert;
+      const int4 ti = p.tiles[tile];
+      int* dn = first ? fa.done + tile : nullptr;
+      switch (ti.z) {
+        case 8:
+          if constexpr (kFine == 0)
+            consumer_item<8, true>(p, ring, stg, bars, slot, ph, ti.x, ti.y, ntile, first, dn, pubq, ti.w);
+          break;
+        case 16:
+          if constexpr (kFine == 0)
+            consumer_item<16, true>(p, ring, stg, bars, slot, ph, ti.x, ti.y, ntile, first, dn, pubq, ti.w);
+          break;
+        case 32:
+          consumer_item<32, true>(p, ring, stg, bars, slot, ph, ti.x, ti.y, ntile, first, dn, pubq, ti.w);
+          break;
+        case 64:
+          consumer_item<64, kFine != 0>(p, ring, stg, bars, slot, ph, ti.x, ti.y, ntile, first, dn, pubq, ti.w);
+          break;
+        case 128:
+          consumer_item<128, kFine != 0>(p, ring, stg, bars, slot, ph, ti.x, ti.y, ntile, first, dn, pubq, ti.w);
+          break;
+        case 160:
+          if constexpr (kFine != 0)
+            consumer_item<160, false>(p, ring, stg, bars, slot, ph, ti.x, ti.y, ntile, first, dn, pubq, ti.w);
+          break;
+        case 192:
+          if constexpr (kFine != 0)
+            consumer_item<192, false>(p, ring, stg, bars, slot, ph, ti.x, ti.y, ntile, first, dn, pubq, ti.w);
+          break;
+        default:
+          consumer_item<256, false>(p, ring, stg, bars, slot, ph, ti.x, ti.y, ntile, first, dn, pubq, ti.w);
+          break;
+      }
+    }
+  }
+}
+
+// ---- tile plan: per expert, tiles of 256 rows plus a remainder of one or two narrower tiles ----
+
+// Width of the tile holding an expert's r remainder rows: the wgmma's token columns. The narrow widths (8, 16) exist
+// only in the kFine = 0 instantiation of the expert kernel, the fine ones (160, 192) only in kFine = 1.
+SGL_DEVICE int rem_tile(int r, bool fine) {
+  if (r == 0) return 0;
+  if (!fine && r <= 8) return 8;
+  if (!fine && r <= 16) return 16;
+  if (r <= 32) return 32;
+  if (r <= 64) return 64;
+  if (r <= 128) return 128;
+  if (fine && r <= 160) return 160;
+  if (fine && r <= 192) return 192;
+  return 256;
+}
+
+// Rows held by a tile of width n with `used` routes. Up to 128 wide, the routes rounded up to 8, the wgmma's column
+// group: such tiles are bound by the weight stream, and the rows are streamed with every weight block. Wider tiles
+// hold n rows.
+SGL_DEVICE int tile_rows(int n, int used) {
+  return n > 128 ? n : (used + 7) & ~7;
+}
+
+// An expert's r remainder rows as one or two tiles of widths na, nb (nb = 0: one tile) holding ra, rb rows: without
+// fine widths, 129..192 rows become 128 + a tile of up to 64, cheaper than one 256-row tile.
+SGL_DEVICE void rem_tiles(int r, bool fine, int& na, int& nb, int& ra, int& rb) {
+  const bool two = !fine && r > 128 && r <= 192;
+  const int a = two ? 128 : r, b = two ? r - 128 : 0;
+  na = rem_tile(a, fine);
+  nb = rem_tile(b, false);
+  ra = tile_rows(na, a);
+  rb = tile_rows(nb, b);
+}
+
+// One warp, lane e = expert e with c routes: writes the expert's tiles (expert, first row, width, rows) into the
+// list and returns the number of tiles of all experts. Each expert's rows are contiguous, in tile order.
+SGL_DEVICE int plan_warp(int c, bool fine, int e, int4* __restrict__ tiles) {
+  // Tile widths of the expert kernel, widest first; the plan lists the tiles in this order (longest items first).
+  constexpr int kTileWidths[] = {256, 192, 160, 128, 64, 32, 16, 8};
+  constexpr int kNumTileWidths = sizeof(kTileWidths) / sizeof(kTileWidths[0]);
+  const int full = c >> 8, r = c & 255;
+  int na, nb, ra, rb;
+  rem_tiles(r, fine, na, nb, ra, rb);
+  const int rows = full * 256 + ra + rb;
+  // [0]: rows; [1 + k]: tiles of width k
+  int cnt[1 + kNumTileWidths], incl[1 + kNumTileWidths], tot[1 + kNumTileWidths];
+  cnt[0] = rows;
+#pragma unroll
+  for (int k = 0; k < kNumTileWidths; ++k)
+    cnt[1 + k] = (k == 0 ? full : 0) + (na == kTileWidths[k]) + (nb == kTileWidths[k]);
+#pragma unroll
+  for (int k = 0; k < 1 + kNumTileWidths; ++k) {
+    int v = cnt[k];
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) {
+      const int up = __shfl_up_sync(0xffffffffu, v, o);
+      if (e >= o) v += up;
+    }
+    incl[k] = v;
+    tot[k] = __shfl_sync(0xffffffffu, v, 31);
+  }
+  const int r0 = incl[0] - rows;
+  int base = 0;  // list index of the first tile of width k
+#pragma unroll
+  for (int k = 0; k < kNumTileWidths; ++k) {
+    const int first = base + incl[1 + k] - cnt[1 + k];
+    if (k == 0) {
+      for (int i = 0; i < full; ++i)
+        tiles[first + i] = make_int4(e, r0 + 256 * i, 256, 256);
+      if (na == 256) tiles[first + full] = make_int4(e, r0 + 256 * full, 256, ra);
+    } else {
+      if (na == kTileWidths[k]) tiles[first] = make_int4(e, r0 + 256 * full, na, ra);
+      if (nb == kTileWidths[k]) tiles[first] = make_int4(e, r0 + 256 * full + ra, nb, rb);
+    }
+    base += tot[1 + k];
+  }
+  return base;
+}
+
+// 4 consecutive bf16 values (8-byte aligned) as fp32.
+SGL_DEVICE float4 load_bf16x4(const __nv_bfloat16* g) {
+  const uint2 v = __ldg(reinterpret_cast<const uint2*>(g));
+  const float2 a = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&v.x));
+  const float2 b = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&v.y));
+  return make_float4(a.x, a.y, b.x, b.y);
+}
+
+// ---- pre-expert norm + scatter: each token's normalized row goes to the tile slot of each of its local routes ----
+// x: [T, 4096] bf16. Writes xt (tile layout), zero-fills the unused rows of every remainder tile, rrow[t * 8 + k] = the
+// route's row (-1: not local) and, from block 0, the plan for the expert kernel (tiles, their count, a zeroed work
+// counter and zeroed per-tile progress).
+// The norm is RMSNorm in fp32 with one rounding to bf16: x * rsqrt(mean(x^2) + eps) * norm_weight.
+// Routes: up to kBlockRoutesMaxTokens tokens every block reads all of topk_ids itself (lid == nullptr), one token per
+// thread, so a route's position is the number of earlier tokens of its expert: no route-position launch, no atomics,
+// and the row order is deterministic. Above that, lid / pos / counts come from moe_route_position_kernel.
+constexpr int kPadFillParts = 2;  // pad-fill blocks per expert; fewer blocks keep the grid in one wave at small T
+constexpr int kBlockRoutesMaxTokens = 256;  // _BLOCK_ROUTES_MAX_TOKENS in the Python op
+template <bool kUsePDL>
+__global__ void __launch_bounds__(256, 1) moe_gather_kernel(
+    const __nv_bfloat16* __restrict__ x,
+    const __nv_bfloat16* __restrict__ norm_weight,
+    float eps,
+    bool apply_norm,
+    const int* __restrict__ topk_ids,
+    int local_start,
+    const int* __restrict__ lid,
+    const int* __restrict__ pos,
+    const int* __restrict__ counts,
+    uint8_t* __restrict__ xt,
+    int* __restrict__ rrow,
+    int T,
+    int4* __restrict__ tiles,
+    int* __restrict__ num_tiles,
+    int* __restrict__ counter,
+    int* __restrict__ done,
+    bool fine) {
+  device::PDLTriggerSecondary<kUsePDL>();
+  device::PDLWaitPrimary<kUsePDL>();
+  const int tok = blockIdx.x;
+  const int tid = threadIdx.x;
+  const bool block_routes = lid == nullptr;
+  __shared__ float red[8];
+  __shared__ int cnt_s[32], off_s[32];
+  __shared__ uint32_t tok_s[8 * 32];  // [warp][expert]: the warp's tokens (bit = lane) with a route to the expert
+  if (block_routes) {
+    uint32_t experts = 0;  // local experts of token tid
+    if (tid < T) {
+      const int4* ids = reinterpret_cast<const int4*>(topk_ids) + 2 * tid;
+      const int4 a = ids[0], b = ids[1];
+      const int id[8] = {a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w};
+#pragma unroll
+      for (int k = 0; k < 8; ++k) {
+        const unsigned d = static_cast<unsigned>(id[k] - local_start);
+        if (d < 32u) experts |= 1u << d;
+      }
+    }
+    uint32_t mine = 0;
+#pragma unroll
+    for (int e = 0; e < 32; ++e) {
+      const uint32_t with_e = __ballot_sync(0xffffffffu, (experts >> e) & 1u);
+      if ((tid & 31) == e) mine = with_e;
+    }
+    tok_s[tid] = mine;
+    __syncthreads();
+  }
+  if (tid < 32) {
+    int c = 0;
+    if (block_routes) {
+#pragma unroll
+      for (int w = 0; w < 8; ++w)
+        c += __popc(tok_s[w * 32 + tid]);
+    } else {
+      c = counts[tid];
+    }
+    cnt_s[tid] = c;
+    const int full = c >> 8, r = c & 255;
+    int na, nb, ra, rb;
+    rem_tiles(r, fine, na, nb, ra, rb);
+    const int rows = full * 256 + ra + rb;
+    int v = rows;
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) {
+      const int a2 = __shfl_up_sync(0xffffffffu, v, o);
+      if (tid >= o) v += a2;
+    }
+    off_s[tid] = v - rows;
+    if (blockIdx.x == 0) {
+      const int planned = plan_warp(c, fine, tid, tiles);
+      for (int i = tid; i < planned; i += 32)
+        done[i] = 0;
+      if (tid == 0) {
+        *num_tiles = planned;
+        *counter = 0;
+      }
+    }
+  }
+  if (tok >= T) {
+    __syncthreads();
+    // pad-row zero fill: block T + e * kPadFillParts + part zeroes part of expert e's pad rows
+    const int idx = tok - T, e = idx / kPadFillParts, part = idx % kPadFillParts;
+    const int c = cnt_s[e];
+    const int full = c >> 8, r = c & 255;
+    int na, nb, ra, rb;
+    rem_tiles(r, fine, na, nb, ra, rb);
+    // remainder tile(s): pad rows [used, rows) of each; tile layout: 64 k-blocks of rows x 128 B
+#pragma unroll
+    for (int q = 0; q < 2; ++q) {
+      const int n = q ? rb : ra;
+      if (n == 0) continue;
+      const int r0 = off_s[e] + 256 * full + (q ? ra : 0);
+      const int used = q ? r - ra : (nb ? ra : r);
+      for (int lr = used + part; lr < n; lr += kPadFillParts) {
+        for (int i = tid; i < 64 * 8; i += 256) {
+          const int kb = i >> 3, ch = i & 7;
+          *reinterpret_cast<uint4*>(xt + (size_t)r0 * 8192 + (size_t)kb * n * 128 + lr * 128 + ch * 16) =
+              make_uint4(0, 0, 0, 0);
+        }
+      }
+    }
+    return;
+  }
+  // thread handles elements [16 * tid, 16 * tid + 16): k-block tid / 4, chunks 2 * (tid % 4) and 2 * (tid % 4) + 1
+  const uint4* src = reinterpret_cast<const uint4*>(x + (size_t)tok * 4096 + tid * 16);
+  uint4 v0 = src[0], v1 = src[1];
+  // the token's routes (row base, tile rows, row in tile), worked out by 8 threads while the row load is in flight
+  __shared__ long long mrow[8];
+  __shared__ int mn[8], mlr[8];
+  __syncwarp();
+  if (tid < 8) {
+    const int k = tid;
+    int l, ps = 0;
+    if (block_routes) {
+      const unsigned d = static_cast<unsigned>(topk_ids[tok * 8 + k] - local_start);
+      l = d < 32u ? static_cast<int>(d) : -1;
+      if (l >= 0) {  // tokens before this one with a route to the same expert
+        const int w = tok >> 5;
+        ps = __popc(tok_s[w * 32 + l] & ((1u << (tok & 31)) - 1u));
+        for (int j = 0; j < w; ++j)
+          ps += __popc(tok_s[j * 32 + l]);
+      }
+    } else {
+      l = lid[tok * 8 + k];
+      ps = pos[tok * 8 + k];
+    }
+    if (l < 0) {
+      rrow[tok * 8 + k] = -1;
+      mn[k] = 0;
+    } else {
+      const int c = cnt_s[l];
+      const int full = c >> 8, r = c & 255;
+      int na, nb, ra, rb;
+      rem_tiles(r, fine, na, nb, ra, rb);
+      const int tl = ps >> 8;
+      int row0 = off_s[l] + 256 * tl, lr = ps & 255, n = tl < full ? 256 : ra;  // n: the tile's rows
+      if (tl >= full && nb && lr >= ra) {                                       // a split remainder's second tile
+        row0 += ra;
+        lr -= ra;
+        n = rb;
+      }
+      rrow[tok * 8 + k] = row0 + lr;
+      mrow[k] = (long long)row0 * 8192 + lr * 128;
+      mn[k] = n;
+      mlr[k] = lr;
+    }
+  }
+  float f[16];
+  const __nv_bfloat162* h0 = reinterpret_cast<const __nv_bfloat162*>(&v0);
+  const __nv_bfloat162* h1 = reinterpret_cast<const __nv_bfloat162*>(&v1);
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    float2 a = __bfloat1622float2(h0[i]), b = __bfloat1622float2(h1[i]);
+    f[2 * i] = a.x;
+    f[2 * i + 1] = a.y;
+    f[8 + 2 * i] = b.x;
+    f[8 + 2 * i + 1] = b.y;
+  }
+  float ss = 0.f;
+#pragma unroll
+  for (int i = 0; i < 16; ++i)
+    ss += f[i] * f[i];
+#pragma unroll
+  for (int o = 16; o > 0; o >>= 1)
+    ss += __shfl_xor_sync(0xffffffffu, ss, o);
+  if ((tid & 31) == 0) red[tid >> 5] = ss;
+  __syncthreads();
+  float tot = 0.f;
+#pragma unroll
+  for (int i = 0; i < 8; ++i)
+    tot += red[i];
+  const float rr = apply_norm ? rsqrtf(tot / 4096.f + eps) : 1.f;
+  uint32_t outw[8];
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const float4 gg = norm_weight ? load_bf16x4(norm_weight + tid * 16 + 4 * i) : make_float4(1.f, 1.f, 1.f, 1.f);
+    __nv_bfloat162 a = __floats2bfloat162_rn(f[4 * i] * rr * gg.x, f[4 * i + 1] * rr * gg.y);
+    __nv_bfloat162 b = __floats2bfloat162_rn(f[4 * i + 2] * rr * gg.z, f[4 * i + 3] * rr * gg.w);
+    outw[2 * i] = bf162_u32(a);
+    outw[2 * i + 1] = bf162_u32(b);
+  }
+  const int kb = tid >> 2, ch0 = 2 * (tid & 3);
+#pragma unroll
+  for (int k = 0; k < 8; ++k) {
+    const int n = mn[k];  // (written before the reduction's __syncthreads)
+    if (n == 0) continue;
+    const int lr = mlr[k];
+    uint8_t* rowp = xt + mrow[k] + (size_t)kb * n * 128;
+    const int x = lr & 7;
+    *reinterpret_cast<uint4*>(rowp + ((ch0 ^ x) << 4)) = make_uint4(outw[0], outw[1], outw[2], outw[3]);
+    *reinterpret_cast<uint4*>(rowp + (((ch0 + 1) ^ x) << 4)) = make_uint4(outw[4], outw[5], outw[6], outw[7]);
+  }
+}
+
+// ---- route positions for more than kBlockRoutesMaxTokens tokens: local expert id and row position inside that
+// expert, for every (token, slot) ----
+// topk_ids: [T, 8] global expert ids; local experts are local_start .. local_start + 31. Writes lid (-1: not local)
+// and pos; counts[e] ends as expert e's route count and must be zero on entry. Positions come from block-local
+// counters and each block reserves its range with one global atomic per expert: a busy expert takes thousands of
+// routes, and per-route atomics on one address would serialize.
+template <bool kUsePDL>
+__global__ void __launch_bounds__(256) moe_route_position_kernel(
+    const int* __restrict__ topk_ids,
+    int local_start,
+    int* __restrict__ lid,
+    int* __restrict__ pos,
+    int* __restrict__ counts,
+    int num_routes) {
+  device::PDLTriggerSecondary<kUsePDL>();
+  device::PDLWaitPrimary<kUsePDL>();
+  __shared__ int s_cnt[32], s_base[32];
+  if (threadIdx.x < 32) s_cnt[threadIdx.x] = 0;
+  __syncthreads();
+  const int route = blockIdx.x * 256 + threadIdx.x;
+  int loc = -1, lpos = 0;
+  if (route < num_routes) {
+    const unsigned d = static_cast<unsigned>(topk_ids[route] - local_start);
+    if (d < 32u) {
+      loc = static_cast<int>(d);
+      lpos = atomicAdd(&s_cnt[loc], 1);
+    }
+  }
+  __syncthreads();
+  if (threadIdx.x < 32) {
+    const int c = s_cnt[threadIdx.x];
+    s_base[threadIdx.x] = c ? atomicAdd(counts + threadIdx.x, c) : 0;
+  }
+  __syncthreads();
+  if (route < num_routes) {
+    lid[route] = loc;
+    pos[route] = loc >= 0 ? s_base[loc] + lpos : 0;
+  }
+}
+
+// Layout of the int32 plan buffer shared by the kernels. The route counts must be zero on entry when
+// moe_route_position_kernel runs; the gather kernel zeroes the work counter and the per-tile progress.
+// The Python op sizes the buffers from the same numbers (_PLAN_HEADER_INTS = kPlanTileDone, and the shape constants).
+constexpr int kPlanCounts = 0;      // [32] routes per expert
+constexpr int kPlanCounter = 32;    // [1] next work item of the expert kernel
+constexpr int kPlanNumTiles = 33;   // [1] tiles in the plan
+constexpr int kPlanTileDone = 128;  // [max_tiles] gate/up blocks finished per tile; [max_tiles, 4] tiles follow
+
+constexpr int kNumLocalExperts = 32;
+constexpr int kExpertDim = 4096;
+constexpr int kTopK = 8;
+// Rows an expert's tiles may hold beyond its routes: under 64 (193 routes left over in a 256-row tile); tiles up to
+// 128 wide hold their routes rounded up to 8.
+constexpr int kMaxPadRows = 64;
+// The plan has room for a tile per kPlanTileRoutes routes plus two per expert, more than any plan lists: an expert's
+// routes fill 256-row tiles, and what is left over takes at most two.
+constexpr int kPlanTileRoutes = 32;
+constexpr int kFineTilesMinTokens = 512;  // from here remainder tiles round to 32 rows; measured on H200
+// Hardware limit: an sm_90 block may use 227 KB of shared memory.
+constexpr int kSmemBytes = 227 * 1024;
+static_assert(1023 + kSmemRing + kNumSlots * kSlotBytes + kStagingBytes <= kSmemBytes, "expert kernel smem");
+
+}  // namespace nvfp4_sm90
+
+}  // namespace muse_spark
+
+/// \brief Routed NVFP4 experts for one rank of Muse Spark on sm_90.
+///
+/// Runs the pre-expert RMSNorm, the gate/up GEMM, SwiGLU and the down GEMM for the 32 experts
+/// `[local_start, local_start + 32)` in two launches chained with PDL. Above 256 tokens a third launch counts the
+/// routes first, into route counts the caller has zeroed (see `plan`). Weight products are exact and accumulate in
+/// fp32; each stage rounds to bf16 where the Marlin path does.
+///
+/// \tparam kUsePDL Launch with programmatic dependent launch.
+/// \param x [T, 4096] bf16, expert input before the pre-expert norm.
+/// \param topk_ids [T, 8] int32, global expert ids.
+/// \param norm_weight [4096] bf16 RMSNorm weight, or none.
+/// \param gate_up [32, 64, 64, 4608] u8, packed by `pack_nvfp4_expert_weights(gated=True)`.
+/// \param down [32, 32, 64, 4608] u8, packed by `pack_nvfp4_expert_weights(gated=False)`.
+/// \param gate_up_scale [32] fp32 global scale of each expert's gate/up weights.
+/// \param down_scale [32] fp32 global scale of each expert's down weights.
+/// \param rows [3, R, 4096] bf16 with R >= 8 T + 32 * 64: gathered input, gate/up output, down output (out).
+/// \param routes [3, T, 8] int32: local expert id and position in the expert (scratch, written above 256 tokens), then
+///   the row of `rows[2]` holding each route's output, or -1 (out).
+/// \param plan [128 + 5 * max_tiles] int32, max_tiles >= T / 4 + 64 and a multiple of 4; above 256 tokens its first
+///   32 entries (route counts) must be zero on entry.
+/// \param local_start First global id of this rank's experts.
+/// \param num_blocks Blocks of the expert kernel: the device's SM count.
+/// \param norm_eps RMSNorm epsilon.
+/// \param apply_norm False skips the pre-expert norm.
+template <bool kUsePDL>
+void muse_spark_nvfp4_experts_sm90(
+    tvm::ffi::TensorView x,
+    tvm::ffi::TensorView topk_ids,
+    tvm::ffi::Optional<tvm::ffi::TensorView> norm_weight,
+    tvm::ffi::TensorView gate_up,
+    tvm::ffi::TensorView down,
+    tvm::ffi::TensorView gate_up_scale,
+    tvm::ffi::TensorView down_scale,
+    tvm::ffi::TensorView rows,
+    tvm::ffi::TensorView routes,
+    tvm::ffi::TensorView plan,
+    int64_t local_start,
+    int64_t num_blocks,
+    double norm_eps,
+    bool apply_norm) {
+  using namespace host;
+  using namespace muse_spark::nvfp4_sm90;
+
+  SymbolicSize T{"num_tokens"};
+  SymbolicSize R{"num_rows"};
+  SymbolicSize P{"plan_size"};
+  SymbolicDevice device_;
+  device_.set_options<kDLCUDA>();
+
+  TensorMatcher({T, kExpertDim}).with_dtype<bf16_t>().with_device(device_).verify(x);
+  TensorMatcher({T, kTopK}).with_dtype<int32_t>().with_device(device_).verify(topk_ids);
+  TensorMatcher({kNumLocalExperts, 2 * kExpertDim / 128, kNumKBlocks, kWeightBlockBytes})
+      .with_dtype<uint8_t>()
+      .with_device(device_)
+      .verify(gate_up);
+  TensorMatcher({kNumLocalExperts, kExpertDim / 128, kNumKBlocks, kWeightBlockBytes})
+      .with_dtype<uint8_t>()
+      .with_device(device_)
+      .verify(down);
+  TensorMatcher({kNumLocalExperts}).with_dtype<fp32_t>().with_device(device_).verify(gate_up_scale).verify(down_scale);
+  TensorMatcher({3, R, kExpertDim}).with_dtype<bf16_t>().with_device(device_).verify(rows);
+  TensorMatcher({3, T, kTopK}).with_dtype<int32_t>().with_device(device_).verify(routes);
+  TensorMatcher({P}).with_dtype<int32_t>().with_device(device_).verify(plan);
+
+  const int num_tokens = static_cast<int>(T.unwrap());
+  const int64_t num_rows = R.unwrap();
+  const int max_tiles = static_cast<int>((P.unwrap() - kPlanTileDone) / 5);
+  const DLDevice device = device_.unwrap();
+
+  RuntimeCheck(x.is_contiguous() && topk_ids.is_contiguous(), "x and topk_ids must be contiguous");
+  RuntimeCheck(rows.is_contiguous() && routes.is_contiguous(), "rows and routes must be contiguous");
+  RuntimeCheck(
+      num_rows >= static_cast<int64_t>(num_tokens) * kTopK + kNumLocalExperts * kMaxPadRows,
+      "rows holds ",
+      num_rows,
+      " rows, too few for ",
+      num_tokens,
+      " tokens");
+  RuntimeCheck(
+      max_tiles % 4 == 0 && max_tiles >= num_tokens * kTopK / kPlanTileRoutes + 2 * kNumLocalExperts,
+      "plan holds ",
+      max_tiles,
+      " tiles, too few for ",
+      num_tokens,
+      " tokens");
+  if (num_tokens == 0) return;
+
+  const bf16_t* norm_weight_ptr = nullptr;
+  if (norm_weight.has_value()) {
+    TensorMatcher({kExpertDim}).with_dtype<bf16_t>().with_device(device_).verify(norm_weight.value());
+    norm_weight_ptr = static_cast<const bf16_t*>(norm_weight.value().data_ptr());
+  }
+
+  auto* plan_ptr = static_cast<int*>(plan.data_ptr());
+  int* counts = plan_ptr + kPlanCounts;
+  int* num_tiles = plan_ptr + kPlanNumTiles;
+  auto* tiles = reinterpret_cast<int4*>(plan_ptr + kPlanTileDone + max_tiles);
+  auto* routes_ptr = static_cast<int*>(routes.data_ptr());
+  int* lid = routes_ptr;
+  int* pos = routes_ptr + static_cast<int64_t>(num_tokens) * kTopK;
+  int* slot_rows = routes_ptr + 2 * static_cast<int64_t>(num_tokens) * kTopK;
+  auto* rows_ptr = static_cast<uint8_t*>(rows.data_ptr());
+  const int64_t rows_bytes = num_rows * kExpertDim * static_cast<int64_t>(sizeof(bf16_t));
+  uint8_t* gathered = rows_ptr;
+  uint8_t* gate_up_out = rows_ptr + rows_bytes;
+  uint8_t* down_out = rows_ptr + 2 * rows_bytes;
+
+  const bool fine = num_tokens >= kFineTilesMinTokens;
+  const bool block_routes = num_tokens <= kBlockRoutesMaxTokens;
+  const auto* topk_ids_ptr = static_cast<const int*>(topk_ids.data_ptr());
+
+  const int num_routes = num_tokens * kTopK;
+  if (!block_routes) {
+    LaunchKernel(dim3((num_routes + 255) / 256), dim3(256), device, 0)
+        .enable_pdl(kUsePDL)(
+            moe_route_position_kernel<kUsePDL>,
+            topk_ids_ptr,
+            static_cast<int>(local_start),
+            lid,
+            pos,
+            counts,
+            num_routes);
+  }
+
+  LaunchKernel(dim3(num_tokens + kNumLocalExperts * kPadFillParts), dim3(256), device, 0)
+      .enable_pdl(kUsePDL)(
+          moe_gather_kernel<kUsePDL>,
+          static_cast<const bf16_t*>(x.data_ptr()),
+          norm_weight_ptr,
+          static_cast<float>(norm_eps),
+          apply_norm,
+          topk_ids_ptr,
+          static_cast<int>(local_start),
+          block_routes ? nullptr : static_cast<const int*>(lid),
+          static_cast<const int*>(pos),
+          static_cast<const int*>(counts),
+          gathered,
+          slot_rows,
+          num_tokens,
+          tiles,
+          num_tiles,
+          plan_ptr + kPlanCounter,
+          plan_ptr + kPlanTileDone,
+          fine);
+
+  const auto make_args = [&](const void* weights, const uint8_t* in, const void* scale, uint8_t* out, int ntiles) {
+    Args a{};
+    a.wrep = static_cast<const uint8_t*>(weights);
+    a.xt = in;
+    a.tiles = tiles;
+    a.num_tiles = num_tiles;
+    a.gscale = static_cast<const float*>(scale);
+    a.out = out;
+    a.ntiles_per_expert = ntiles;
+    a.counter = plan_ptr + kPlanCounter;
+    a.mul16 = 16u;
+    a.mul64 = 64u;
+    return a;
+  };
+  FusedArgs fa{};
+  fa.g1 = make_args(gate_up.data_ptr(), gathered, gate_up_scale.data_ptr(), gate_up_out, 2 * kExpertDim / 128);
+  fa.g2 = make_args(down.data_ptr(), gate_up_out, down_scale.data_ptr(), down_out, kExpertDim / 128);
+  fa.done = plan_ptr + kPlanTileDone;
+  const auto kernel = fine ? moe_fused_persistent<1, kUsePDL> : moe_fused_persistent<0, kUsePDL>;
+  // The opt-in belongs to the kernel as loaded in the current context, so it is set on every call and not once per
+  // process: a host-side attribute, and nothing a CUDA graph replays.
+  RuntimeDeviceCheck(cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, kSmemBytes));
+  LaunchKernel(dim3(static_cast<unsigned>(num_blocks)), dim3(kFusedThreads), device, kSmemBytes)
+      .enable_pdl(kUsePDL)(kernel, fa);
+}
+
+}  // namespace sglang
