+// Routed NVFP4 experts for Muse Spark on sm_90 (H100 / H200): one rank's 32 experts of 4096 x 4096.
+//
+// Kernels, chained with programmatic dependent launch (each lets the next one launch as soon as all its blocks run,
+// then waits for the previous one's results before touching global memory):
+//   1. route positions (only above 256 tokens): local expert id and row position of every (token, slot);
+//   2. gather: pre-expert RMSNorm, rows scattered into per-expert tiles, tile plan;
+//   3. experts: gate/up GEMM, SwiGLU and down GEMM for every tile, one persistent block per SM.
+// The expert kernel streams the packed weights with bulk copies, dequantizes NVFP4 to bf16 in registers
+// (code x block scale is exact in bf16) and feeds them to wgmma as the register operand; accumulation is fp32.
+// Rounding follows the Marlin path stage by stage, so the two agree up to the order of the fp32 sums: each GEMM's
+// sums round to bf16 before the global scale, SwiGLU reads bf16, and the norm rounds once (as torch's rms_norm).
+
+#pragma once
+
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+
+#include <sgl_kernel/atomic.cuh>
+#include <sgl_kernel/mbarrier.cuh>
+#include <sgl_kernel/utils.cuh>
+
+#include <tvm/ffi/container/tensor.h>
+#include <tvm/ffi/optional.h>
+
+#include <cstdint>
+
+namespace sglang {
+
+namespace muse_spark {
+
+namespace nvfp4_sm90 {
+
+constexpr int kNumKBlocks = 64;          // k-blocks of 64 elements (K = 4096)
+constexpr int kWeightBlockBytes = 4608;  // bytes per (n-tile, k-block) weight block: 4096 code + 512 scale bytes
+
+using device::ptx::to_shared;
+
+// Not the sgl_kernel/mbarrier.cuh helpers: these need a "memory" clobber (generic loads of a ring slot follow the
+// wait and precede the arrive), and they take 32-bit shared addresses, which the expert kernel keeps in registers.
+SGL_DEVICE void mbar_init(uint32_t bar, uint32_t count) {
+  asm volatile("mbarrier.init.shared.b64 [%0], %1;" ::"r"(bar), "r"(count) : "memory");
+}
+
+SGL_DEVICE void mbar_wait(uint32_t bar, uint32_t parity) {
+  asm volatile(
+      "{\n.reg .pred P1;\nWAIT_%=:\n"
+      "mbarrier.try_wait.parity.shared.b64 P1, [%0], %1;\n"
+      "@!P1 bra WAIT_%=;\n}\n" ::"r"(bar),
+      "r"(parity)
+      : "memory");
+}
+
+SGL_DEVICE uint64_t mbar_arrive(uint32_t bar) {
+  uint64_t state;
+  asm volatile("mbarrier.arrive.shared.b64 %0, [%1];" : "=l"(state) : "r"(bar) : "memory");
+  return state;
+}
+
+SGL_DEVICE void mbar_expect_tx(uint32_t bar, uint32_t bytes) {
+  asm volatile("mbarrier.arrive.expect_tx.shared.b64 _, [%0], %1;" ::"r"(bar), "r"(bytes) : "memory");
+}
+
+SGL_DEVICE void prefetch_l2(const void* src, uint32_t bytes) {
+  asm volatile("cp.async.bulk.prefetch.L2.global [%0], %1;" ::"l"(src), "r"(bytes) : "memory");
+}
+
+// global -> shared bulk copy (async proxy), completing on mbarrier `bar` (complete_tx)
+SGL_DEVICE void bulk_g2s(uint32_t dst, const void* src, uint32_t bytes, uint32_t bar) {
+  asm volatile(
+      "cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1], %2, [%3];" ::"r"(dst),
+      "l"(src),
+      "r"(bytes),
+      "r"(bar)
+      : "memory");
+}
+
+// shared -> global bulk copy (async proxy), tracked per thread with bulk groups
+SGL_DEVICE void bulk_s2g(void* dst, uint32_t src, uint32_t bytes) {
+  asm volatile(
+      "cp.async.bulk.global.shared::cta.bulk_group [%0], [%1], %2;" ::"l"(dst), "r"(src), "r"(bytes) : "memory");
+}
+
+SGL_DEVICE void wg_fence() {
+  asm volatile("wgmma.fence.sync.aligned;" ::: "memory");
+}
+
+SGL_DEVICE void wg_commit() {
+  asm volatile("wgmma.commit_group.sync.aligned;" ::: "memory");
+}
+
+template <int N>
+SGL_DEVICE void wg_wait() {
+  asm volatile("wgmma.wait_group.sync.aligned %0;" ::"n"(N) : "memory");
+}
+
+SGL_DEVICE void named_bar_sync(int id, int n) {
+  asm volatile("bar.sync %0, %1;" ::"r"(id), "r"(n) : "memory");
+}
+
+// CTA-scope acquire load and release store of an int in shared memory.
+SGL_DEVICE int ld_acquire_cta(uint32_t addr) {
+  int v;
+  asm volatile("ld.acquire.cta.shared.b32 %0, [%1];" : "=r"(v) : "r"(addr) : "memory");
+  return v;
+}
+
+SGL_DEVICE void st_release_cta(uint32_t addr, int v) {
+  asm volatile("st.release.cta.shared.b32 [%0], %1;" ::"r"(addr), "r"(v) : "memory");
+}
+
+// Four 8x8 bf16 matrices stored transposed; lane l addresses row l & 7 of matrix l >> 3.
+SGL_DEVICE void stmatrix_x4_trans(uint32_t addr, const uint32_t (&r)[4]) {
+  asm volatile(
+      "stmatrix.sync.aligned.m8n8.x4.trans.shared.b16 [%0], {%1, %2, %3, %4};" ::"r"(addr),
+      "r"(r[0]),
+      "r"(r[1]),
+      "r"(r[2]),
+      "r"(r[3])
+      : "memory");
+}
+
+// SwiGLU's gate in the form of the stock activation kernel (elementwise/activation.cuh), so both paths
+// compute the same function.
+SGL_DEVICE float silu(float x) {
+  return x / (1.0f + expf(-x));
+}
+
+// wgmma descriptor for a K-major, 128B-swizzled B tile (rows of 128 B, 8-row atoms of 1024 B).
+SGL_DEVICE uint64_t desc_sw128(uint32_t saddr) {
+  uint64_t d = 0;
+  d |= (uint64_t)((saddr & 0x3FFFF) >> 4);
+  d |= (uint64_t)1 << 16;            // LBO (unused for swizzled K-major)
+  d |= (uint64_t)(1024 >> 4) << 32;  // SBO: 8 rows x 128 B
+  d |= (uint64_t)1 << 62;            // SWIZZLE_128B
+  return d;
+}
