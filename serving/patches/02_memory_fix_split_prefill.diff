+// wgmma m64nNk16: bf16 A from registers, B from shared memory (desc); d holds this thread's N / 2 fp32 accumulators.
+// The operand lists stay several to a line; clang-format would give each of the up to 134 operands its own line.
+// clang-format off
+template <int N>
+SGL_DEVICE void wgmma_rs(float (&d)[128], const uint32_t (&a)[4], uint64_t desc, int scale_d);
